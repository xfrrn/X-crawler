# 运行时数据目录（SQLite 库、twscrape 账号库）
DATA_DIR=./data

# API Key，逗号分隔多个，请求头 Authorization: Bearer <key>
API_KEYS=dev-key-1,dev-key-2

# 默认轮询间隔（秒）
DEFAULT_POLL_INTERVAL=15

# 采集模式：twscrape（真实抓取）或 mock（无账号时端到端验证/演示）
SCRAPER_MODE=twscrape

# twscrape 采集账号库文件（相对 DATA_DIR）
TWSCRAPE_ACCOUNTS_DB=./data/accounts.db

# 自适应轮询：退避上限（秒）、连续失败自动暂停阈值、错峰系数
MAX_POLL_INTERVAL=300
PAUSE_AFTER_ERRORS=10
JITTER_FACTOR=0.3

# SSE 事件回放条数（新订阅者先补发最近 N 条）
SSE_REPLAY_SIZE=50

# mock 自第 N 次轮询起持续失败（0=永不），用于验证退避/暂停
MOCK_FAIL_START=0

# Web 管理面板后台登录（独立于 API Key 的服务端 session）
# 部署时务必改成强密码和随机 secret，否则任何人可登录后台
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ADMIN_SESSION_SECRET=change-me-random-string

# 爬 X 用的全局代理（国内网络直连被墙，必填）。twscrape 读 TWS_PROXY 环境变量，
# 所有采集账号（密码登录 / cookies 导入）都会走这个代理。
# 格式：http://127.0.0.1:7890  或  socks5://127.0.0.1:1080
TWS_PROXY=

# ------------------------------------------------------------------
# 多平台监控（抖音 dy / 快手 ks / 小红书 xhs）——基于外部 MediaCrawler 子进程
# ------------------------------------------------------------------
# 总开关：false 则完全不启平台监控
MC_ENABLED=true

# MediaCrawler 目录（本项目以 git submodule 自带，克隆时 --recurse-submodules 拉全；
# 首次启动会自动 uv sync + 应用补丁 + 装浏览器，无需手动初始化）
MC_REPO_PATH=./mediacrawler

# 每平台轮询间隔（秒），错峰：启动后 xhs 立即、dy 延后 ~10min、ks 延后 ~20min
MC_POLL_INTERVAL_XHS=1800
MC_POLL_INTERVAL_DY=1800
MC_POLL_INTERVAL_KS=1800

# 登录方式：本版 MediaCrawler 默认开启 CDP 模式——连本机已启动、开了远程调试的 Chrome
#（端口 9222）。CDP Chrome 里已登录的平台账号优先复用（此时 MC_LOGIN_TYPE 和
# MC_COOKIES_* 都被忽略）；连不上 CDP 会等 ~60s 后回退标准模式，按 MC_LOGIN_TYPE 用
# cookies / qrcode / phone。CDP 浏览器启动方法见 README「多平台监控」段。
MC_LOGIN_TYPE=cookie
MC_COOKIES_XHS=            # 兜底用：CDP 已登录时用不到；建议与 CDP 双保险都填
MC_COOKIES_DY=
MC_COOKIES_KS=

# 每个博主每轮最多抓取的最新动态条数（三平台统一）
MC_MAX_POSTS_PER_CREATOR=15

# 无头模式：CDP 连接已登录浏览器时建议 false（能看到浏览器）；标准模式才真正生效
MC_HEADLESS=false

# 单次抓取子进程硬超时（秒）；首次运行 uv run 解析依赖 + 首轮抓取可能偏慢
MC_SUBPROCESS_TIMEOUT=900

# ------------------------------------------------------------------
# 微信公众号监控（wx）——主进程 Playwright 扫码会话，不受 MC_ENABLED 控制
# ------------------------------------------------------------------
# 每个公众号默认每 30 分钟抓取最新 15 篇元数据
WECHAT_POLL_INTERVAL=1800
WECHAT_MAX_ARTICLES=15
